{
  "name": "carno-offline",
  "version": "1.0.0",
  "private": true,
  "description": "CARNO emergency offline desktop app (Electron + SQLite)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build:renderer": "vite build",
    "start": "electron .",
    "test:phase7": "node scripts/test-phase7.cjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "marked": "^18.0.9",
    "sql.js": "^1.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "vite": "^5.4.19",
    "wait-on": "^8.0.4"
  }
}
