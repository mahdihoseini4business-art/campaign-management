# Desktop Electron app — not part of the Liara web deploy
offline-app/

# Let Liara configure npm mirror during build (custom .npmrc blocks it)
.npmrc

# Heavy / local-only — .liaraignore replaces .gitignore on deploy
node_modules/
.git/
docs/
scripts/
dist/
.mimocode/
.vercel/
.cursor/
*.xlsx
*-logs.txt
*.md

# Secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Supabase CLI ephemeral — keep functions/_shared (imported by Vite)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/**/.env
supabase/**/node_modules/
supabase/**/.deno/
