VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Used for password hashing + session HMAC — use a long random value, never commit real secrets
VITE_HASH_SECRET=your-random-secret-key-here
# Stable admin OTP phone — keep the same across deploys so ownership stays linked
VITE_ADMIN_PHONE=09123456789

# SMS Configuration (set on Supabase Edge Functions — not in the frontend)
SMS_USERNAME=your-smart-sms-username
SMS_PASSWORD=your-smart-sms-password
SMS_SENDER=your-sender-number
