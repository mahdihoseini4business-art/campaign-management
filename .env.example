VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Used for password hashing + session HMAC — use a long random value, never commit real secrets
# Phase 1+: DB access must rely on Supabase Auth JWT + RLS, not this client secret.
VITE_HASH_SECRET=your-random-secret-key-here
# Stable *tenant* admin OTP phone for the first/default organization — keep stable across deploys
VITE_ADMIN_PHONE=09123456789

# --- Server-only secrets (Supabase Edge / dashboard — NEVER prefix with VITE_) ---
# Comma-separated phones allowed into /platform super-admin (wired in Phase 1)
# PLATFORM_ADMIN_PHONES=09120000000,09121111111
# SUPABASE_SERVICE_ROLE_KEY=...
